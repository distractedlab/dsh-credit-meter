{
  "name": "dsh-credit-meter",
  "version": "1.0.3",
  "description": "Remaining DeepSeek account credit as a composer-dock reading",
  "license": "MIT",
  "author": "DistractedLab (https://github.com/distractedlab)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/distractedlab/dsh-credit-meter.git"
  },
  "homepage": "https://github.com/distractedlab/dsh-credit-meter#readme",
  "bugs": {
    "url": "https://github.com/distractedlab/dsh-credit-meter/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek",
    "deepseek-harness",
    "credit",
    "balance"
  ],
  "type": "module",
  "engines": {
    "dsh": "^0.2.2-rc.2"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "docs",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}
